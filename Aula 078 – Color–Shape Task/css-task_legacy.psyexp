      <Param name="loopType" updates="None" val="sequential" valType="str"/>
      <Param name="nReps" updates="None" val="COLOR_TRIALS" valType="num"/>
      <Param name="name" updates="None" val="color_training" valType="code"/>
      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="training_trial"/>
    <LoopTerminator name="color_training"/>
    <LoopInitiator loopType="TrialHandler" name="shape_instructions">
